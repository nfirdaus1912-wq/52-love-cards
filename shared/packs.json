{
  "version": 4,
  "packs": [
    {
      "id": "couple",
      "name": "Couple",
      "blurb": "Questions that leave you feeling closer.",
      "cards": [
        {
          "id": "couple-1",
          "text": "What ordinary weekday moment with them would you replay if you could?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-2",
          "text": "Which of their laughs is your favorite, and what usually causes it?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-3",
          "text": "What is one thing they do that makes you feel chosen, not just included?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "medium"
        },
        {
          "id": "couple-4",
          "text": "If you planned a perfect nothing-day together, how would it start?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-5",
          "text": "What compliment from them do you still remember word for word?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "medium"
        },
        {
          "id": "couple-6",
          "text": "Hold their hand and name three things you noticed about them this week.",
          "mood": "challenge",
          "roundType": "your_turn",
          "intensity": "light"
        },
        {
          "id": "couple-7",
          "text": "Tell them a story about the first time you felt proud to be theirs.",
          "mood": "challenge",
          "roundType": "your_turn",
          "intensity": "medium"
        },
        {
          "id": "couple-8",
          "text": "What small ritual would you like to start as a pair this month?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
