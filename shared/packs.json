        {
          "id": "couple-9",
          "text": "What is a tiny way they take care of you that they might not notice?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-10",
          "text": "Say one thing you want more of together, without blaming anyone.",
          "mood": "challenge",
          "roundType": "your_turn",
          "intensity": "medium"
        },
        {
          "id": "couple-11",
          "text": "What song would you put on if you wanted them to come sit closer?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-12",
          "text": "Name a habit of theirs you secretly hope never changes.",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-13",
          "text": "If you had one extra hour together this week, how would you spend it?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "medium"
        },
        {
          "id": "couple-14",
          "text": "Tell them the nicest thing they did that they probably forgot.",
