          "roundType": "your_turn",
          "intensity": "light"
        },
        {
          "id": "couple-15",
          "text": "What would a lazy Sunday with them look like in perfect detail?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-16",
          "text": "Hold eye contact and say one thing you are grateful they brought into your life.",
          "mood": "challenge",
          "roundType": "your_turn",
          "intensity": "medium"
        },
        {
          "id": "couple-17",
          "text": "What is a small weekday text from them that always lands well?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-18",
          "text": "Which of their everyday outfits do you notice first, and why?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        },
        {
          "id": "couple-19",
          "text": "If you could bottle one hour of your relationship, which hour would it be?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "medium"
        },
        {
          "id": "couple-20",
          "text": "Tell them one thing you want to try together that costs almost nothing.",
          "mood": "challenge",
          "roundType": "your_turn",
          "intensity": "light"
        },
        {
          "id": "couple-21",
          "text": "What nickname or tone of voice from them makes you feel safest?",
          "mood": "romantic",
          "roundType": "know_me",
          "intensity": "light"
        }
      ]
    },
    {
