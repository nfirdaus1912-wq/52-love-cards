# Copy to parameters.env and fill in. Apps read these at build time.
# Do not commit parameters.env if it contains private bucket names you want hidden.
# The mobile apps only HTTP GET a public JSON file — no AWS SDK, no IAM keys in the client.

# Required: public HTTPS URL of packs.json (S3 website, object URL, or CloudFront)
PACKS_URL=https://dashing-llama-bed5cc.netlify.app/packs.json

# Used by deploy docs / CI to upload shared/packs.json — not compiled into the app
AWS_REGION=ap-south-1
AWS_S3_BUCKET=YOUR_BUCKET
AWS_S3_OBJECT_KEY=packs.json

# Subscription product IDs (must match App Store Connect + Play Console)
# Google Play auto-renew periods: weekly, monthly, or yearly. A 3-day plan is not a valid Play base plan.
IAP_PRODUCT_7DAY=app.lovecards.fiftytwo.sub.7day
IAP_PRODUCT_MONTHLY=app.lovecards.fiftytwo.sub.monthly
IAP_PRODUCT_YEARLY=app.lovecards.fiftytwo.sub.yearly

# Legal links shown on the paywall (Apple requires these for subscriptions)
TERMS_URL=https://dashing-llama-bed5cc.netlify.app/terms.html
PRIVACY_URL=https://dashing-llama-bed5cc.netlify.app/privacy.html
SUPPORT_EMAIL=support@52lovecards.app
